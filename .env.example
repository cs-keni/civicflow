# Copy this file to .env and fill in values before running docker-compose up.
# Never commit .env to version control.

# SQL Server SA password (min 8 chars, uppercase + lowercase + digit + special)
SA_PASSWORD=YourStrong_Password_1!

# AI provider: "mock" (no API key needed) or "claude" (requires ANTHROPIC_API_KEY)
AI_PROVIDER=mock

# Required only when AI_PROVIDER=claude
ANTHROPIC_API_KEY=
