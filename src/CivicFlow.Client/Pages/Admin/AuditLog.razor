@page "/admin/audit-log"
@attribute [Authorize(Roles = "Admin")]
@inject CivicFlowApiClient Api

<PageTitle>Audit Log — CivicFlow</PageTitle>

<div class="cf-page-header">
    <h1>Audit Log</h1>
</div>

<div class="cf-table-wrapper">
    <table class="cf-table" aria-label="Audit log entries">
        <thead>
            <tr>
                <th scope="col">When</th>
                <th scope="col">User</th>
                <th scope="col">Action</th>
                <th scope="col">Entity</th>
                <th scope="col">IP</th>
            </tr>
        </thead>
        <tbody>
            @if (_loading)
            {
                <SkeletonRows Count="8" Columns="5" />
            }
            else if (_result?.Items.Count > 0)
            {
                @foreach (var entry in _result.Items)
                {
                    <tr>
                        <td style="white-space:nowrap;font-size:.85rem">@entry.OccurredAt.ToString("MMM d, yyyy h:mm tt")</td>
                        <td style="font-size:.85rem">@(entry.UserId is not null ? entry.UserId[..8] + "…" : "System")</td>
                        <td><span class="cf-badge @ActionClass(entry.Action)" style="font-size:.75rem">@entry.Action</span></td>
                        <td style="font-size:.85rem;font-family:monospace">@entry.EntityType #@entry.EntityId</td>
                        <td style="font-size:.85rem;font-family:monospace">@(entry.IpAddress ?? "—")</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5">
                        <div class="cf-empty-state"><p>No audit log entries.</p></div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (_result is not null)
    {
        <PaginationBar Page="_page" TotalPages="_result.TotalPages" TotalCount="_result.TotalCount"
                       OnPageChange="LoadPageAsync" />
    }
</div>

@code {
    private bool _loading = true;
    private int _page = 1;
    private PaginatedResult<AuditLogDto>? _result;

    protected override async Task OnInitializedAsync() => await LoadPageAsync(1);

    private async Task LoadPageAsync(int page)
    {
        _loading = true;
        _page = page;
        _result = await Api.GetAuditLogsAsync(page);
        _loading = false;
    }

    private static string ActionClass(string action) => action.ToUpperInvariant() switch
    {
        "CREATE" => "cf-badge-approved",
        "UPDATE" => "cf-badge-submitted",
        "DELETE" => "cf-badge-denied",
        _ => "cf-badge-underreview"
    };
}
