@* Animated table skeleton — renders Count rows of loading placeholder cells. *@

@for (int i = 0; i < Count; i++)
{
    <tr aria-hidden="true">
        @for (int j = 0; j < Columns; j++)
        {
            <td><span class="cf-skeleton cf-skeleton-text @(j == 0 ? "wide" : j % 2 == 0 ? "medium" : "narrow")" /></td>
        }
    </tr>
}

@code {
    [Parameter] public int Count { get; set; } = 3;
    [Parameter] public int Columns { get; set; } = 5;
}
